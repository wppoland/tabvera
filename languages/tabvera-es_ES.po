#. Plugin Name of the plugin
#: tabvera.php
msgid "Tabvera - Product Tabs for WooCommerce"
msgstr "Tabvera - Pestañas de producto para WooCommerce"

#. Plugin URI of the plugin
#: tabvera.php
msgid "https://plogins.com/tabvera/"
msgstr "https://plogins.com/tabvera/"

#. Description of the plugin
#: tabvera.php
msgid "Add custom tabs with your own content to WooCommerce product pages."
msgstr ""
"Añade pestañas personalizadas con su propio contenido a las páginas de "
"productos de WooCommerce."

#. Author of the plugin
#: tabvera.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: tabvera.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

