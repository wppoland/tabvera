#. Plugin Name of the plugin
#: tabvera.php
msgid "Tabvera - Product Tabs for WooCommerce"
msgstr "Tabvera - Product Tabs for WooCommerce"

#. Plugin URI of the plugin
#: tabvera.php
msgid "https://plogins.com/tabvera/"
msgstr "https://plogins.com/tabvera/"

#. Description of the plugin
#: tabvera.php
msgid "Add custom tabs with your own content to WooCommerce product pages."
msgstr ""
"Dodaje do stron produktów WooCommerce własne zakładki z dowolną treścią."

#. Author of the plugin
#: tabvera.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: tabvera.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

